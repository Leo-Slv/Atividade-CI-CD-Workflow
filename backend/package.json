{
  "name": "crud-pessoas-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Express do CRUD de pessoas (CPF, nome, data de nascimento, idade)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --runInBand --coverage",
